{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Void",
  "mainBinaryName": "Void",
  "version": "0.1.0",
  "identifier": "local.bosecontrolcenter.app",
  "build": {
    "beforeDevCommand": {
      "cwd": "../frontend",
      "script": "npm run dev"
    },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": {
      "cwd": "../frontend",
      "script": "npm run build"
    },
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Void",
        "width": 1040,
        "height": 720,
        "minWidth": 880,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'",
      "freezePrototype": true
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Local control center for Bose headphones and earbuds",
    "longDescription": "A fully local control center for Bose headphones and earbuds. Works offline with no cloud services, no accounts, and no telemetry.",
    "copyright": "",
    "publisher": "Void contributors",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ]
      }
    }
  }
}
