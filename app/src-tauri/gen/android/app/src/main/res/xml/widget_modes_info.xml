<?xml version="1.0" encoding="utf-8"?>
<!-- Four cells wide and two tall to begin with: the modes, and under them
     the equalizer. Made one cell tall it is the modes alone. The system
     redraws it every half hour at most, which is only a safety net: the
     application redraws it whenever the headphones report something. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_modes"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="48dp"
    android:previewLayout="@layout/widget_modes"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
